# Скопируйте этот файл в .env и заполните. Файл .env никому не передавайте.

# Токен бота. Выдаёт @BotFather в Telegram после команды /newbot.
BOT_TOKEN=

# Номера чатов, куда приходят заявки, через запятую.
# Узнать свой номер: запустите сервер, напишите боту /start — он пришлёт номер.
ADMIN_CHAT_IDS=

# Пароль для кнопки «Сохранить и опубликовать» в админке сайта. Не короче 12 символов.
# Пусто = публиковать из админки нельзя.
ADMIN_PASSWORD=

# Адрес и порт, на которых сервер слушает запросы. Снаружи его закрывает Caddy или nginx (см. README).
HOST=127.0.0.1
PORT=8080

# 1 — сервер стоит за Caddy или nginx (так и должно быть в интернете). 0 — прямой доступ без прокси.
TRUST_PROXY=1

# Папки сайта и данных. Обычно менять не нужно.
SITE_DIR=site
DATA_DIR=data

# ---------- Новости и студия white-label сайтов ----------
# Адрес сервера снаружи — для ссылок на сайты клиентов в Telegram.
PUBLIC_URL=

# Ключ Claude (console.anthropic.com). Пусто — агенты работают в офлайн-режиме: сайты собираются по шаблонам, без нейросети.
ANTHROPIC_API_KEY=

# Модель агентов. По умолчанию — Claude Opus 5.5.
STUDIO_MODEL=claude-opus-5-5

# Предел вызовов Claude на один проект (защита бюджета; дальше агенты отвечают без нейросети).
STUDIO_MAX_CALLS=120

# Новых сайтов в сутки на одного пользователя бота. Администраторам — без предела. 0 — только администраторы.
STUDIO_DAILY_LIMIT=2

# Сколько сайтов собирается одновременно и сколько раундов спора у агентов.
STUDIO_CONCURRENCY=1
STUDIO_DEBATE_ROUNDS=2

# 0 — выключить студию (останутся сайт, заявки и новости).
STUDIO_ENABLED=1
