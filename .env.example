# Скопируйте этот файл в .env и заполните. Файл .env никому не передавайте.

# Токен бота. Выдаёт @BotFather в Telegram после команды /newbot.
BOT_TOKEN=

# Номера чатов, куда приходят заявки, через запятую.
# Узнать свой номер: запустите сервер, напишите боту /start — он пришлёт номер.
ADMIN_CHAT_IDS=

# Необязательно. Личные номера людей через запятую: только они могут управлять ботом из группы.
# Заявки в группу (номер с минусом в ADMIN_CHAT_IDS) видят все её участники, а /last, /post и /forget отвечают только
# администраторам. Личные чаты из ADMIN_CHAT_IDS уже считаются администраторами, их сюда вписывать не нужно.
# Свой номер покажет /id в группе.
ADMIN_USER_IDS=

# Пароль для кнопки «Сохранить и опубликовать» в админке сайта. Не короче 12 символов.
# Пусто = публиковать из админки нельзя.
ADMIN_PASSWORD=

# База PostgreSQL — заявки, подписчики, проекты студии. Как её завести — README, шаг 2.
# Вид: postgresql://пользователь:пароль@адрес:5432/имя_базы, например postgresql://codexlab:ДлинныйПароль@localhost:5432/codexlab
DATABASE_URL=

# Адрес и порт, на которых сервер слушает запросы. Снаружи его закрывает Caddy или nginx (см. README).
HOST=127.0.0.1
PORT=8080

# Роль процесса. all — всё в одном (один сервер). На двух машинах (deploy/uzcloud/README.md) роль задают
# compose-файлы: web — страницы, заявки и сайты клиентов; admin — админка, бот, студия, рассылки, схема базы.
ROLE=all

# Прокси на других машинах, которым верим адрес посетителя (X-Forwarded-For), через запятую: адреса или сети,
# например 10.0.0.5 или 10.0.0.0/24. Прокси на этой же машине (127.0.0.1) доверенный и так. На двух машинах —
# частный адрес машины сайта в настройках машины админки (его задаёт compose.admin.yml).
TRUSTED_PROXIES=

# 1 — сервер стоит за Caddy или nginx (так и должно быть в интернете). 0 — прямой доступ без прокси.
# Адрес клиента из прокси берётся, только если прокси работает на этой же машине (127.0.0.1).
# cloud — облачная платформа (Render и похожие): адрес берётся из X-Forwarded-For, если запрос пришёл из её внутренней сети.
# На Render строку можно не задавать: сервер сам узнаёт Render и включает cloud.
TRUST_PROXY=1

# Сколько дней хранить заявки (имя, контакты, ТЗ). Потом сервер удаляет их сам.
# Политика конфиденциальности на сайте обещает 6 месяцев: поменяете число — поправьте и текст политики.
# 0 — не удалять (тогда политика будет неправдой).
ORDER_RETENTION_DAYS=180

# Папки сайта и данных. Обычно менять не нужно.
SITE_DIR=site
DATA_DIR=data

# ---------- Новости и студия white-label сайтов ----------
# Адрес сервера снаружи — для ссылок на сайты клиентов в Telegram.
PUBLIC_URL=

# Ключ Claude (console.anthropic.com). Пусто — агенты работают в офлайн-режиме: сайты собираются по шаблонам, без нейросети.
ANTHROPIC_API_KEY=

# Модель агентов. По умолчанию — Claude Opus 5.5.
STUDIO_MODEL=claude-opus-5-5

# Предел вызовов Claude на один проект (защита бюджета; дальше агенты отвечают без нейросети).
STUDIO_MAX_CALLS=120

# Новых сайтов в сутки на одного пользователя бота. Администраторам — без предела. 0 — только администраторы.
STUDIO_DAILY_LIMIT=2

# Сколько сайтов собирается одновременно и сколько раундов спора у агентов.
STUDIO_CONCURRENCY=1
STUDIO_DEBATE_ROUNDS=2

# 0 — выключить студию (останутся сайт, заявки и новости).
STUDIO_ENABLED=1
