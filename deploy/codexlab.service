# Автозапуск сервера. Файл кладётся в /etc/systemd/system/codexlab.service
[Unit]
Description=Codex Lab: сайт студии и приём заявок
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexlab
WorkingDirectory=/opt/codexlab-server
ExecStart=/opt/codexlab-server/venv/bin/python -m app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Сервису разрешено писать только в папку данных: тексты и цены сайта — в базе, site/ меняют только релизы
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/codexlab-server/data

[Install]
WantedBy=multi-user.target
