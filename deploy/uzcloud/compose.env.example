# /opt/codexlab/env/compose.env на обеих машинах (права 600, владелец root).
# Переменные для compose.web.yml и compose.admin.yml — адреса машин и пароль
# базы. Настройки самого сайта (бот, пароль админки) — в app.env.

# Частные адреса машин в сети UzCloud
WEB_IP=
ADMIN_IP=

# Пароль владельца базы codexlab: длинный, случайный, например
#   openssl rand -hex 24
# Одинаковый на обеих машинах. В git, чат и журналы не попадает.
POSTGRES_PASSWORD=

# Только машина сайта: домены через запятую. Репетиция — new.codexlab.uz,
# после переезда — codexlab.uz, www.codexlab.uz
SITE_HOSTS=new.codexlab.uz

# Версия образа (ghcr.io/xondamirx9/xlab:<TAG>) — задаёт выкладка
# TAG=
